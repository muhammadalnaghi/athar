<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Sideload-only permissions — Path A in Master Brief §5.4. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- ENH-009 (2026-10-16 amendment to Master Brief §2.2 / ADR-002): install-time
         INTERNET for the OPT-IN signed shared merchant catalog download only —
         one fixed endpoint, no identifier headers, no telemetry, off by default.
         personalFullSms flavor only; storeSafe stays verifiably offline, and the
         catalog transport re-checks the permission at request time. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <receiver
            android:name="com.athar.ingestion.smslistener.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
