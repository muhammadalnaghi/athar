    <!-- Support diagnostics export -->
    <string name="settings_support_diagnostics_title">تشخيص الدعم</string>
    <string name="settings_support_diagnostics_body">صدّر تقرير JSON منقّحًا لمساعدة الدعم في تحسين قراءة الرسائل: أعداد الرسائل، بصمات مرسلين مجهولة، شكل نص الرسالة، مجموعات القوالب الفاشلة، وأخطاء منقّحة. لا يحتوي على نص الرسائل الخام أو الأرصدة أو أرقام البطاقات أو الحسابات.</string>
