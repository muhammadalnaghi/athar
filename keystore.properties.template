# Copy this file to `keystore.properties` and fill in real values.
# `keystore.properties` is git-ignored; `*.keystore` / `*.jks` are also git-ignored.
#
# CI (`.github/workflows/build-personal-apk.yml`) materializes the same file from secrets:
#   ATHAR_KEYSTORE_BASE64  — base64 of the PKCS12 keystore
#   ATHAR_STORE_PASSWORD   — store password (must equal key password for PKCS12)
#   ATHAR_KEY_ALIAS        — key alias (athar-release)
#   ATHAR_KEY_PASSWORD     — key password
#
# Generate a persistent keystore once; never rotate casually (breaks in-place updates):
#
#   keytool -genkeypair \
#     -keystore keystore/athar-release.keystore \
#     -alias athar-release \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storepass "<password>" -keypass "<password>" \
#     -dname "CN=Athar Personal, O=Your Name, C=SA" \
#     -storetype PKCS12

storeFile=keystore/athar-release.keystore
storePassword=
keyAlias=athar-release
keyPassword=
